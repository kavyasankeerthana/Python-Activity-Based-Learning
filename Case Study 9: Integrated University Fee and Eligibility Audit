6. Pseudocode
START
  Set students = [
    {"id": "S101", "name": "Anil", "fee": 0, "att": 82, "internal": 28},
    {"id": "S102", "name": "Bhavana", "fee": 1500, "att": 68, "internal": 15}
  ]

  FOR each s IN students DO
    reasons = []
    IF s.fee > 0 THEN APPEND "Unpaid Fee" TO reasons
    IF s.att < 75 THEN APPEND "Low Attendance" TO reasons
    IF s.internal < 20 THEN APPEND "Low Internal Marks" TO reasons

    IF len(reasons) == 0 THEN
      ticket = "ISSUED"
    ELSE
      ticket = "HELD: " + JOIN(reasons)
    END IF

    PRINT s.id, s.name, ticket
  END FOR
END
7. Python Source Code
# Integrated University Fee and Eligibility Audit

students = [
    {"id": "21NR1A0501", "name": "Anil", "fee_due": 0, "attendance": 85, "internal": 32},
    {"id": "21NR1A0502", "name": "Bhavana", "fee_due": 2500, "attendance": 80, "internal": 28},
    {"id": "21NR1A0503", "name": "Charan", "fee_due": 0, "attendance": 65, "internal": 18},
    {"id": "21NR1A0504", "name": "Divya", "fee_due": 0, "attendance": 90, "internal": 45}
]

print("=== UNIVERSITY COMPREHENSIVE ELIGIBILITY AUDIT ===")
print(f"{'Student ID':<12} {'Name':<10} {'Fee Due':<10} {'Att. %':<8} {'Internal':<10} {'Hall Ticket Status'}")
print("-" * 75)

for s in students:
    reasons = []
    if s["fee_due"] > 0:
        reasons.append(f"Fee Pending (Rs.{s['fee_due']})")
    if s["attendance"] < 75:
        reasons.append(f"Low Att. ({s['attendance']}%)")
    if s["internal"] < 20:
        reasons.append(f"Low Int. ({s['internal']}/50)")
        
    if len(reasons) == 0:
        status = "APPROVED / ISSUED"
    else:
        status = "BLOCKED: " + ", ".join(reasons)
        
    print(f"{s['id']:<12} {s['name']:<10} Rs.{s['fee_due']:<7} {s['attendance']:<8} {s['internal']:<10} {status}")

