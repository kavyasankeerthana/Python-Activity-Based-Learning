6. Pseudocode
START
  Set records = [
    ("Anil", [45, 58, 72]),
    ("Bhavana", [80, 65, 50]),
    ("Charan", [55, 40, 60])
  ]
  FOR each (name, marks) IN records DO
    avg = SUM(marks) / len(marks)
    IF marks[2] > marks[1] AND marks[1] > marks[0] THEN
      trend = "Improving"
    ELSE IF marks[2] < marks[1] AND marks[1] < marks[0] THEN
      trend = "Declining"
    ELSE
      trend = "Fluctuating"
    END IF
    weak = False
    IF avg < 40 THEN weak = True
    PRINT name, avg, trend, weak
  END FOR
END

