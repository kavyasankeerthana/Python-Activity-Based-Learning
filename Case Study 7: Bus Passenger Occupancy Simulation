6. Pseudocode
START
  Set capacity = 40, current = 0, peak = 0
  Set stops = [
    ("Depot", 15, 0),
    ("Stop A", 20, 5),
    ("Stop B", 15, 2),
    ("Stop C", 5, 10)
  ]
  FOR each (stop, board, alight) IN stops DO
    current = current - alight + board
    IF current > peak THEN peak = current
    overload = False
    IF current > capacity THEN overload = True
    PRINT stop, board, alight, current, overload
  END FOR
  PRINT peak
END

7. Python Source Code
# Bus Passenger Occupancy Simulation
BUS_CAPACITY = 40
route_stops = [
    ("Main Depot", 25, 0),
    ("University Gate", 18, 5),
    ("Market Complex", 12, 10),
    ("Tech Park", 8, 20),
    ("Terminal Station", 0, 28)
]
current_passengers = 0
peak_occupancy = 0
print(f"Bus Capacity: {BUS_CAPACITY} Seats
")
print(f"{'Stop Name':<18} {'Boarded':<8} {'Alighted':<9} {'Current Count':<15} {'Status'}")
print("-" * 65)
for stop, board, alight in route_stops:
    current_passengers = current_passengers - alight + board    
    if current_passengers > peak_occupancy:
        peak_occupancy = current_passengers        
    status = "OK"
    if current_passengers > BUS_CAPACITY:
        status = f"OVERLOAD (+{current_passengers - BUS_CAPACITY})"     
    print(f"{stop:<18} {board:<8} {alight:<9} {current_passengers:<15} {status}")
print("-" * 65)
print(f"Trip Summary: Peak Occupancy = {peak_occupancy} passengers | Max Capacity = {BUS_CAPACITY}")

