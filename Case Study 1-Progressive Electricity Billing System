Pseudocode
START
  Set SLABS = [(100, 3.0), (100, 5.0), (100, 7.0)]
  Set TOP_RATE = 9.0, FIXED_CHARGE = 50
  Set previous_bill = 0
  FOR each month in reading_list DO
    units = month.units
    rem = units
    energy = 0
    IF rem > 100 THEN energy += 100 * 3.0; rem -= 100
    ELSE energy += rem * 3.0; rem = 0
    IF rem > 0 THEN
      IF rem > 100 THEN energy += 100 * 5.0; rem -= 100
      ELSE energy += rem * 5.0; rem = 0
    IF rem > 0 THEN
      IF rem > 100 THEN energy += 100 * 7.0; rem -= 100
      ELSE energy += rem * 7.0; rem = 0
    IF rem > 0 THEN energy += rem * TOP_RATE
    surcharge = 0
    IF units > 400 THEN surcharge = energy * 0.08
    subtotal = energy + FIXED_CHARGE + surcharge
    rebate = 0
    IF month.paid_online THEN rebate = subtotal * 0.05
    total = subtotal - rebate
    alert = False
    IF previous_bill > 0 AND total > (previous_bill * 1.30) THEN
      alert = True
    PRINT month.name, units, energy, total, alert
    previous_bill = total
  END FOR
END

 Python Source Code
# Progressive Electricity Billing System
monthly_data = [("Jan", 120, True),
    ("Feb", 130, True),
    ("Mar", 150, True),
    ("Apr", 240, True),
    ("May", 260, False),
    ("Jun", 450, True)]
FIXED_CHARGE = 50.0
previous_total = 0.0
print("Month  Units  Energy   Fixed  Surch.  Rebate   Total   Status")
print("-" * 65)
for month_name, units, paid_online in monthly_data:
    rem = units
    energy = 0.0
    # Slab 1: 0 - 100
    if rem > 100:
        energy += 100 * 3.0
        rem -= 100
    else:
        energy += rem * 3.0
        rem = 0
    # Slab 2: 101 - 200
    if rem > 0:
        if rem > 100:
            energy += 100 * 5.0
            rem -= 100
        else:
            energy += rem * 5.0
            rem = 0      
    # Slab 3: 201 - 300
    if rem > 0:
        if rem > 100:
            energy += 100 * 7.0
            rem -= 100
        else:
            energy += rem * 7.0
            rem = 0     
    # Above 300
    if rem > 0:
        energy += rem * 9.0  
    surcharge = 0.0
    if units > 400:
        surcharge = energy * 0.08   
    subtotal = energy + FIXED_CHARGE + surcharge
    rebate = 0.0
    if paid_online:
        rebate = subtotal * 0.05  
    total = subtotal - rebate
    alert = ""
    if previous_total > 0 and total > (previous_total * 1.30):
        alert = "UNUSUAL INCREASE" 
    previous_total = total
    print(f"{month_name:<6} {units:<6} {energy:<8.2f} {FIXED_CHARGE:<6.2f} {surcharge:<7.2f} {rebate:<7.2f} {total:<8.2f} {alert}")


 
