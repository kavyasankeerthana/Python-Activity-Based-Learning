6. Pseudocode
START
  Set students = [
    ("Anil", 45, 70),
    ("Bhavana", 60, 70),
    ("Charan", 30, 50)
  ]
  FOR each (name, attended, total) IN students DO
    curr_pct = (attended / total) * 100
    IF curr_pct >= 75.0 THEN
      needed = 0
      status = "Eligible"
    ELSE
      # (attended + N) / (total + N) >= 0.75
      # attended + N >= 0.75*total + 0.75*N
      # 0.25*N >= 0.75*total - attended
      # N >= 3*total - 4*attended
      needed = (3 * total) - (4 * attended)
      IF needed < 0 THEN needed = 0
      status = "Shortage"
    END IF
    PRINT name, curr_pct, status, needed
  END FOR
END

7. Python Source Code
# Attendance Recovery Computation
students = [
    {"name": "Anil", "attended": 45, "total": 70},
    {"name": "Bhavana", "attended": 58, "total": 70},
    {"name": "Charan", "attended": 30, "total": 60}
]
TARGET_PCT = 75.0
print(f"{'Student Name':<12} {'Attended':<10} {'Total':<8} {'Current %':<12} {'Status':<12} {'Recovery Classes Needed'}")
print("-" * 75)
for s in students:
    a = s["attended"]
    t = s["total"]
    pct = (a / t) * 100.0  
    if pct >= TARGET_PCT:
        status = "Eligible"
        needed = 0
    else:
        status = "Ineligible"
        # Solve (a + n) / (t + n) >= 0.75
        needed = (3 * t) - (4 * a)
        if needed < 0:
            needed = 0
    print(f"{s['name']:<12} {a:<10} {t:<8} {pct:<12.2f} {status:<12} {needed} consecutive classes")

