6. Pseudocode
START
  Set records = [
    ("BK101", 12, 14),
    ("BK102", 18, 14),
    ("BK103", 25, 14)
  ]

  total_fine = 0

  FOR each (book_id, kept, allowed) IN records DO
    delay = kept - allowed

    IF delay <= 0 THEN
      fine = 0
    ELSE IF delay <= 5 THEN
      fine = delay * 2
    ELSE
      fine = (5 * 2) + ((delay - 5) * 5)
    END IF

    total_fine += fine
    PRINT book_id, delay, fine
  END FOR

  PRINT total_fine
END
7. Python Source Code
# Library Borrowing and Fine Reconciliation

borrow_records = [
    ("BK-2021", 12, 14),   # On time
    ("BK-3045", 18, 14),   # 4 days late (4 * 2 = Rs. 8)
    ("BK-1102", 24, 14),   # 10 days late (5*2 + 5*5 = 10 + 25 = Rs. 35)
    ("BK-4099", 14, 14)    # On time
]

print(f"{'Book ID':<10} {'Days Kept':<10} {'Allowed':<10} {'Overdue Days':<14} {'Fine Charged (Rs.)'}")
print("-" * 60)

grand_total_fine = 0

for book_id, kept, allowed in borrow_records:
    delay = max(0, kept - allowed)
    
    if delay == 0:
        fine = 0
    elif delay <= 5:
        fine = delay * 2
    else:
        fine = (5 * 2) + ((delay - 5) * 5)
        
    grand_total_fine += fine
    
    print(f"{book_id:<10} {kept:<10} {allowed:<10} {delay:<14} Rs. {fine}")

print("-" * 60)
print(f"Total Outstanding Library Fine Reconciliation: Rs. {grand_total_fine}")

